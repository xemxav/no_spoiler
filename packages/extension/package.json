{
  "name": "@no-spoiler/extension",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsc --noEmit --watch --preserveWatchOutput & node scripts/build.mjs --watch",
    "build": "tsc -p tsconfig.json && node scripts/build.mjs",
    "icons": "node scripts/render-icons.mjs",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@no-spoiler/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
